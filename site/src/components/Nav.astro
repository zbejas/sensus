---
// Root-absolute so the section links keep working from /docs/* pages (a bare
// #terminal would resolve against the current docs URL). Same-document from /.
const links = [
  { href: "/#terminal", label: "Terminal" },
  { href: "/#agent", label: "Agent" },
  { href: "/#lifecycle", label: "Detach" },
  { href: "/#endpoints", label: "Models" },
  { href: "/docs/", label: "Docs" },
]
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label="sensus home">
      <span>sensus</span><span class="brand-cursor" aria-hidden="true"></span>
    </a>
    <nav class="nav-links" aria-label="Sections">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="nav-right">
      <a
        class="nav-gh"
        href="https://github.com/zbejas/sensus"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a class="btn" href="/#install">Install</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--border-soft);
    /* The frame is named so a page change leaves it out of the animated
       snapshot (see global.css, "Page changes"). */
    view-transition-name: site-nav;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.75rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-left: auto;
    font-size: 0.9rem;
  }

  .nav-links a {
    position: relative;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--fg);
  }

  /* The underline draws in from the left instead of switching on. */
  .nav-links a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.28rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.22s var(--ease-out);
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Scrolling under the sticky bar adds elevation: a scroll-driven animation
     where supported, so no scroll listener and no layout thrash. The timeline
     sits in its own rule because bundlers that fold longhands into the
     `animation` shorthand emit a form some engines reject. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .nav {
        animation: nav-lift linear both;
      }

      html .nav {
        animation-timeline: scroll(root);
        animation-range: 0 72px;
      }
    }
  }

  @keyframes nav-lift {
    from {
      box-shadow: 0 0 0 0 transparent;
    }
    to {
      box-shadow: var(--shadow-nav);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links a::after {
      transition: none;
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .nav-gh {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem;
    margin: -0.35rem;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .nav-gh:hover {
    color: var(--fg);
  }

  .nav-gh svg {
    display: block;
  }

  @media (max-width: 760px) {
    .nav-links {
      display: none;
    }

    .nav-right {
      margin-left: auto;
    }
  }
</style>
