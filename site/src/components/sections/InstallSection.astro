---
import InstallCommand from "../InstallCommand.astro"

const systemWide = "curl -fsSL https://sensus.sh/install | bash -s -- -g"
---

<section id="install" class="section">
  <div class="wrap install" data-reveal-stagger>
    <h2 class="h2">Install sensus.</h2>
    <p class="body">
      One line. The release binary is checksum-verified.
    </p>
    <div class="cmd">
      <InstallCommand />
    </div>
    <p class="req mono">Linux or macOS · x86_64/aarch64 · works over SSH</p>
    <div class="alt">
      <p class="alt-label">
        System-wide install — <code>/usr/local/bin</code>, uses <code>sudo</code> when needed
      </p>
      <InstallCommand
        size="sm"
        command={systemWide}
        label="Copy the system-wide install command"
      />
    </div>
    <p class="flags">
      <a href="/docs/install/">All install options</a> · <a href="/docs/development/">build from source</a>
    </p>
  </div>
</section>

<style>
  .install {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1.4rem;
    text-align: center;
  }

  .install .body {
    max-width: 56ch;
  }

  .cmd {
    width: min(100%, 560px);
    margin-top: 0.5rem;
  }

  .alt {
    display: grid;
    gap: 0.5rem;
    width: min(100%, 560px);
    text-align: left;
  }

  .alt-label {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .req {
    color: var(--fg-muted);
  }

  .flags {
    margin: 0;
    color: var(--fg-faint);
    font-size: 0.875rem;
  }
</style>
