{
  "bindings": [
    {
      "action": "open-settings",
      "keys": [
        "ctrl+o"
      ],
      "label": "Open settings",
      "description": "endpoints, keys, themes, globals",
      "category": "settings",
      "categoryLabel": "Settings",
      "slash": "/settings"
    },
    {
      "action": "open-agents",
