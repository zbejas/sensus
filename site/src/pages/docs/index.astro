---
import { getCollection } from "astro:content"

import Docs from "../../layouts/Docs.astro"
import manifest from "../../data/docs-manifest.json"

const entries = await getCollection("docs")
const descriptions = new Map(entries.map((entry) => [entry.id, entry.data.description]))
const live = manifest.docs
  .filter((entry) => entry.status === "live")
  .sort((a, b) => a.order - b.order)
---

<Docs
  title="The sensus manual"
  description="Everything sensus does, one page at a time."
  currentSlug={null}
>
  <ul class="index-list">
    {
      live.map((entry) => (
        <li>
          <a href={`/docs/${entry.slug}/`}>
            <span class="index-title">{entry.title}</span>
            <span class="index-desc">{descriptions.get(entry.slug) ?? ""}</span>
            <svg class="index-arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path
                d="M6 3.5l4.5 4.5L6 12.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</Docs>

<style>
  .index-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index-list li {
    margin: 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .index-list li:first-child {
    border-top: 1px solid var(--border-soft);
  }

  .index-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 1rem 0.2rem;
    text-decoration: none;
  }

  .index-title {
    color: var(--fg);
    font-weight: 600;
  }

  .index-desc {
    grid-column: 1;
    color: var(--fg-muted);
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .index-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--fg-faint);
    transition:
      transform 0.15s var(--ease-out),
      color 0.15s var(--ease-out);
  }

  .index-list a:hover .index-title {
    color: var(--accent);
  }

  .index-list a:hover .index-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .index-arrow {
      transition: none;
    }
  }
</style>
